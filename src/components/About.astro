---
---
<!-- ABOUT -->
<section id="about" class="about light">
  <div class="wrap about-grid">
    <div>
      <h2 class="about-title" data-words>We are Ask Studios</h2>
      <div class="about-copy rv">
        <p>We are a photography studio that wants every moment to last. With years of experience in weddings, commercial campaigns, events and product work, we create images that look good and also carry the feeling of the day.</p>
        <p>From intimate celebrations to brand campaigns, we make photographs that are personal, professional and memorable, because every frame deserves to leave an impression.</p>
      </div>
      <div class="stats">
        <div class="stat rv"><strong data-count="10" data-suffix="+">10+</strong><span>Years of <br>experience</span></div>
        <div class="stat rv"><strong data-count="200">200</strong><span>Happy <br>clients</span></div>
      </div>
    </div>
    <div class="collage">
      <!-- the track is layout-neutral on desktop (display: contents); on phones it becomes a looping marquee -->
      <div class="collage-track">
        <figure class="ph c1 rv-img" data-speed="-60"><img src="img/wedding.jpg" alt="Bride and groom embracing in a garden"></figure>
        <figure class="ph c2 rv-img" data-speed="40"><img src="img/amber.jpg" alt="Portrait of a woman in warm amber light"></figure>
        <figure class="ph c3 rv-img" data-speed="-90"><img src="img/perfume.jpg" alt="Amber perfume bottle with a gold cap"></figure>
        <figure class="ph c4 rv-img" data-speed="70"><img src="img/grad.jpg" alt="Graduate in cap and gown holding a diploma"></figure>
        <!-- duplicate set so the mobile marquee loops seamlessly; hidden on larger screens -->
        <figure class="ph dup" aria-hidden="true"><img src="img/wedding.jpg" alt=""></figure>
        <figure class="ph dup" aria-hidden="true"><img src="img/amber.jpg" alt=""></figure>
        <figure class="ph dup" aria-hidden="true"><img src="img/perfume.jpg" alt=""></figure>
        <figure class="ph dup" aria-hidden="true"><img src="img/grad.jpg" alt=""></figure>
      </div>
    </div>
  </div>
</section>
