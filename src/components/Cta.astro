---
import ArrowIcon from './ArrowIcon.astro';
---
<!-- CTA -->
<section class="cta band" id="book">
  <div class="cta-media ph"><img src="img/cta.jpg" alt=""></div>
  <div class="cta-inner wrap">
    <h2 class="cta-title" data-words>Let's Make Something Worth Framing</h2>
    <p class="cta-copy">Join 200+ couples, brands and event hosts who trust Ask Studios with the moments that matter. Tell us about your day and we'll reply within 24 hours.</p>
    <a href="#contact" class="cta-btn">Book a session
      <ArrowIcon />
    </a>
  </div>
</section>
