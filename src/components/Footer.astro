---
import Logo from './Logo.astro';
---
<!-- FOOTER -->
<footer class="foot" id="contact">
  <div class="wrap foot-top">
    <div class="foot-brand">
      <Logo />
      <p>Ask Studios is dedicated to capturing the beautiful moments of life in all their glory. We work across a wide range of styles.</p>
    </div>
    <ul class="foot-col">
      <li><button class="foot-mail" id="copyMail" data-mail="hello@askstudios.co" title="Copy email">hello@askstudios.co</button></li>
      <li><a href="https://instagram.com" target="_blank" rel="noopener" class="roll">Instagram</a></li>
      <li><a href="https://youtube.com" target="_blank" rel="noopener" class="roll">YouTube</a></li>
      <li><a href="https://behance.net" target="_blank" rel="noopener" class="roll">Behance</a></li>
      <li><a href="https://facebook.com" target="_blank" rel="noopener" class="roll">Facebook</a></li>
    </ul>
    <ul class="foot-col">
      <li><a href="#gallery" class="roll">Work</a></li>
      <li><a href="#about" class="roll">About</a></li>
      <li><a href="#services" class="roll">Services</a></li>
      <li><a href="#contact" class="roll">Contact</a></li>
    </ul>
  </div>
  <div class="wrap foot-legal">
    <span>Copyright © Ask Studios 2026</span>
    <a href="#top" class="roll">Privacy Policy</a>
  </div>
  <div class="strip" aria-label="Recent work">
    <figure class="ph" style="--h:56%"><img src="img/fashion.jpg" alt="Model in a cream outfit"></figure>
    <figure class="ph" style="--h:74%"><img src="img/prewed.jpg" alt="Couple lying in tall grass"></figure>
    <figure class="ph" style="--h:48%"><img src="img/amber.jpg" alt="Portrait in amber light"></figure>
    <figure class="ph" style="--h:100%"><img src="img/wedding.jpg" alt="Bride and groom in a garden"></figure>
    <figure class="ph" style="--h:78%"><img src="img/grad2.jpg" alt="Graduate holding white flowers"></figure>
  </div>
</footer>
