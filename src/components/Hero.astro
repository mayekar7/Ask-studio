---
import ArrowIcon from './ArrowIcon.astro';
---
<!-- HERO -->
<section class="hero" id="top">
  <div class="hero-media ph" id="heroMedia">
    <img src="img/hero-studio.jpg" alt="Motion-blurred portrait of a man against a sage green wall">
  </div>
  <div class="hero-shade"></div>
  <div class="hero-inner">
    <h1 class="hero-title"><span class="ln"><span>Your Creative</span></span><span class="ln"><span>Photography Studio</span></span></h1>
    <p class="hero-copy">Ask Studios captures life's moments. We shoot everything from portraits to weddings and events, telling your story. Our team makes sure every shot reflects your vision.</p>
    <div class="hero-bottom">
      <a href="#contact" class="hero-cta">Book Now
        <ArrowIcon />
      </a>
    </div>
  </div>
</section>
