---
import FrameTitle from './FrameTitle.astro';
---
<!-- SERVICES -->
<section id="services" class="band svc-sec">
  <div class="wrap">
    <div class="sec-head"><FrameTitle text="Services" /></div>
    <div class="svc-grid">
      <div class="svc-media" id="svcMedia">
        <figure class="ph on"><img src="img/candle.jpg" alt="Wedding couple laughing at a candlelit table"></figure>
        <figure class="ph"><img src="img/fashion.jpg" alt="Model in a cream outfit for a fashion campaign"></figure>
        <figure class="ph"><img src="img/concert.jpg" alt="Crowd with raised hands under purple stage lights"></figure>
        <figure class="ph"><img src="img/watch.jpg" alt="Wristwatch on a stone block with leather goods"></figure>
        <span class="cap" id="svcCap">[01] Wedding</span>
      </div>
      <ol class="svc-list" id="svcList">
        <li class="svc on rv" tabindex="0"><span class="n">[01]</span><div class="svc-body"><h3>Wedding</h3>
          <p class="svc-desc">Full or half day coverage with a storytelling approach. You get candid moments, family portraits and a finished digital album, with prints on request.</p></div></li>
        <li class="svc rv" tabindex="0"><span class="n">[02]</span><div class="svc-body"><h3>Commercial</h3>
          <p class="svc-desc">Brand and campaign shoots planned around your brief. We deliver retouched images sized for your website, social media and print.</p></div></li>
        <li class="svc rv" tabindex="0"><span class="n">[03]</span><div class="svc-body"><h3>Event Coverage</h3>
          <p class="svc-desc">Corporate and private events documented as they happen. Highlights arrive within 48 hours and the full gallery follows within a week.</p></div></li>
        <li class="svc rv" tabindex="0"><span class="n">[04]</span><div class="svc-body"><h3>Product</h3>
          <p class="svc-desc">Studio and lifestyle shots for e-commerce and catalogues. You get a written quote up front that lists exactly what is included.</p></div></li>
      </ol>
    </div>
  </div>
</section>
